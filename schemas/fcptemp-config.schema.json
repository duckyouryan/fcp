{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fcptemp service configuration",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "fcp_socket": { "type": "string", "minLength": 1 },
    "hwmon_root": { "type": "string", "minLength": 1, "default": "/sys/class/hwmon" },
    "poll_interval_ms": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 1000 }
  },
  "required": ["fcp_socket"],
  "additionalProperties": false
}
