{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fancontrol-custom-pwm client API messages",
  "description": "The root schema validates client requests. Each request and response is one JSON object on a line (JSON Lines) sent over the AF_UNIX/SOCK_STREAM control socket. Response schemas are available under $defs/Response.",
  "oneOf": [
    { "$ref": "#/$defs/StatusRequest" },
    { "$ref": "#/$defs/FansListRequest" },
    { "$ref": "#/$defs/FanSetRequest" },
    { "$ref": "#/$defs/FanKickstartRequest" }
  ],
  "$defs": {
    "RequestId": {
      "description": "Optional request correlation value. The server echoes it in the response; omitted IDs are returned as null. Clients should use a string or integer.",
      "type": ["string", "integer", "null"]
    },
    "ResponseId": {
      "description": "Echo of the request id, or null when no id was supplied or the request could not be parsed.",
      "type": ["string", "integer", "null"]
    },
    "FanMode": {
      "type": "string",
      "enum": ["low", "high", "percent"],
      "description": "low and high apply the configured value once and disable cycling. percent cycles between configured low/high values using throttle."
    },
    "NullableFanMode": {
      "description": "null means the fan's control is currently inactive or its control file is unavailable.",
      "oneOf": [
        { "$ref": "#/$defs/FanMode" },
        { "type": "null" }
      ]
    },
    "Throttle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of each PWM cycle spent at the configured high value. It is not a measurement of physical fan RPM."
    },
    "StatusRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/RequestId" },
        "command": { "const": "status" }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "FansListRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/RequestId" },
        "command": { "const": "fans.list" },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Optional exact fan label. When provided, the response contains only that fan; an unknown label returns unknown_fan."
        }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "FanSetRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/RequestId" },
        "command": { "const": "fan.set" },
        "label": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/FanMode" },
        "throttle": { "$ref": "#/$defs/Throttle" }
      },
      "required": ["command", "label"],
      "anyOf": [
        { "required": ["mode"] },
        { "required": ["throttle"] }
      ],
      "additionalProperties": false,
      "description": "At least one of mode or throttle is required. If mode is supplied, it always determines the active behavior, regardless of throttle. If mode is omitted, throttle 0 selects low, 100 selects high, and 1..99 selects percent. Any supplied throttle is stored for future use of percent mode."
    },
    "FanKickstartRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/RequestId" },
        "command": { "const": "fan.kickstart" },
        "label": { "type": "string", "minLength": 1 }
      },
      "required": ["command", "label"],
      "additionalProperties": false,
      "description": "Retry discovery and activation of control for one fan. This does not change its stored mode or throttle."
    },
    "FanStatus": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "mode": { "$ref": "#/$defs/NullableFanMode" },
        "throttle": { "$ref": "#/$defs/Throttle" }
      },
      "required": ["label", "mode", "throttle"],
      "additionalProperties": false
    },
    "FanView": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "mode": { "$ref": "#/$defs/NullableFanMode" },
        "throttle": { "$ref": "#/$defs/Throttle" },
        "rpm": {
          "description": "Current RPM, or null when RPM reporting is not configured or available.",
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["label", "mode", "throttle", "rpm"],
      "additionalProperties": false
    },
    "StatusData": {
      "type": "object",
      "properties": {
        "fans": { "type": "array", "items": { "$ref": "#/$defs/FanStatus" } }
      },
      "required": ["fans"],
      "additionalProperties": false
    },
    "FansListData": {
      "type": "object",
      "properties": {
        "fans": { "type": "array", "items": { "$ref": "#/$defs/FanView" } }
      },
      "required": ["fans"],
      "additionalProperties": false
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ResponseId" },
        "ok": { "const": true },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/StatusData" },
            { "$ref": "#/$defs/FansListData" },
            { "$ref": "#/$defs/FanView" }
          ]
        }
      },
      "required": ["id", "ok", "data"],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ResponseId" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_request",
                "invalid_parameter",
                "unknown_command",
                "unknown_fan",
                "kickstart_failed",
                "invalid_json",
                "request_too_large"
              ]
            },
            "message": { "type": "string" }
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["id", "ok", "error"],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        { "$ref": "#/$defs/SuccessResponse" },
        { "$ref": "#/$defs/ErrorResponse" }
      ]
    }
  }
}
