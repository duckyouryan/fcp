{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fcptemp client API messages",
  "description": "One JSON object per line over the fcptemp AF_UNIX/SOCK_STREAM control socket.",
  "oneOf": [
    {
      "$ref": "#/$defs/StatusRequest"
    },
    {
      "$ref": "#/$defs/SensorsListRequest"
    },
    {
      "$ref": "#/$defs/RulesListRequest"
    },
    {
      "$ref": "#/$defs/RuleSetRequest"
    },
    {
      "$ref": "#/$defs/RuleDeleteRequest"
    },
    {
      "$ref": "#/$defs/ControlSetRequest"
    }
  ],
  "$defs": {
    "RequestId": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "StatusRequest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "command": {
          "const": "status"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "SensorsListRequest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "command": {
          "const": "sensors.list"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "RulesListRequest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "command": {
          "const": "rules.list"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "RuleSetRequest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "command": {
          "const": "rule.set"
        },
        "rule": {
          "$ref": "#/$defs/Rule"
        }
      },
      "required": [
        "command",
        "rule"
      ],
      "additionalProperties": false
    },
    "RuleDeleteRequest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "command": {
          "const": "rule.delete"
        },
        "fan": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "command",
        "fan"
      ],
      "additionalProperties": false
    },
    "ControlSetRequest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "command": {
          "const": "control.set"
        },
        "enabled": {
          "type": "boolean"
        },
        "fan": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "command",
        "enabled"
      ],
      "additionalProperties": false
    },
    "CurvePoint": {
      "type": "object",
      "properties": {
        "temp_c": {
          "type": "number"
        },
        "throttle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "temp_c",
        "throttle"
      ],
      "additionalProperties": false
    },
    "Curve": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "linear"
            },
            "min_temp_c": {
              "type": "number"
            },
            "max_temp_c": {
              "type": "number"
            },
            "min_throttle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "max_throttle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "type",
            "min_temp_c",
            "max_temp_c",
            "min_throttle",
            "max_throttle"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "power"
            },
            "min_temp_c": {
              "type": "number"
            },
            "max_temp_c": {
              "type": "number"
            },
            "min_throttle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "max_throttle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "exponent": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 8
            }
          },
          "required": [
            "type",
            "min_temp_c",
            "max_temp_c",
            "min_throttle",
            "max_throttle",
            "exponent"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "points"
            },
            "min_temp_c": {
              "type": "number"
            },
            "max_temp_c": {
              "type": "number"
            },
            "min_throttle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "max_throttle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "points": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/CurvePoint"
              }
            }
          },
          "required": [
            "type",
            "min_temp_c",
            "max_temp_c",
            "min_throttle",
            "max_throttle",
            "points"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "fan": {
          "type": "string",
          "minLength": 1
        },
        "sensor": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "curve": {
          "$ref": "#/$defs/Curve"
        }
      },
      "required": [
        "fan",
        "sensor",
        "curve"
      ],
      "additionalProperties": false
    }
  }
}
