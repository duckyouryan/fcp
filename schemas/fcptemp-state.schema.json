{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fcptemp persistent state",
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "automation_enabled": {"type": "boolean", "default": false},
    "rules": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/Rule"}
    }
  },
  "required": ["version", "automation_enabled", "rules"],
  "additionalProperties": false,
  "$defs": {
    "CurvePoint": {
      "type": "object",
      "properties": {
        "temp_c": {"type": "number"},
        "throttle": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "required": ["temp_c", "throttle"],
      "additionalProperties": false
    },
    "Curve": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {"const": "linear"},
            "min_temp_c": {"type": "number"},
            "max_temp_c": {"type": "number"},
            "min_throttle": {"type": "integer", "minimum": 0, "maximum": 100},
            "max_throttle": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "required": ["type", "min_temp_c", "max_temp_c", "min_throttle", "max_throttle"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "power"},
            "min_temp_c": {"type": "number"},
            "max_temp_c": {"type": "number"},
            "min_throttle": {"type": "integer", "minimum": 0, "maximum": 100},
            "max_throttle": {"type": "integer", "minimum": 0, "maximum": 100},
            "exponent": {"type": "number", "minimum": 0.25, "maximum": 8}
          },
          "required": ["type", "min_temp_c", "max_temp_c", "min_throttle", "max_throttle", "exponent"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "points"},
            "min_temp_c": {"type": "number"},
            "max_temp_c": {"type": "number"},
            "min_throttle": {"type": "integer", "minimum": 0, "maximum": 100},
            "max_throttle": {"type": "integer", "minimum": 0, "maximum": 100},
            "points": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/CurvePoint"}}
          },
          "required": ["type", "min_temp_c", "max_temp_c", "min_throttle", "max_throttle", "points"],
          "additionalProperties": false
        }
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "fan": {"type": "string", "minLength": 1},
        "sensor": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "curve": {"$ref": "#/$defs/Curve"}
      },
      "required": ["fan", "sensor", "enabled", "curve"],
      "additionalProperties": false
    }
  }
}
