import { ScrollView } from "std-widgets.slint";

// Reusable monochrome controls. The main window owns the palette; controls
// only receive the current scheme and never introduce a colored accent.
component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> dark-theme: true;
    in property <bool> primary: false;
    in property <bool> is-enabled: true;
    in property <length> control-width: 38px;
    callback clicked();

    width: root.control-width;
    height: 38px;
    border-radius: 9px;
    background: !root.is-enabled
        ? (root.dark-theme ? #292929 : #e7e7e7)
        : root.primary
            ? (root.dark-theme ? #eeeeee : #292929)
            : (touch.has-hover
                ? (root.dark-theme ? #414141 : #dedede)
                : (root.dark-theme ? #333333 : #e8e8e8));

    Text {
        text: root.label;
        width: parent.width;
        height: parent.height;
        color: !root.is-enabled
            ? (root.dark-theme ? #777777 : #9b9b9b)
            : root.primary
                ? (root.dark-theme ? #171717 : #fafafa)
                : (root.dark-theme ? #eeeeee : #222222);
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.is-enabled;
        clicked => { root.clicked(); }
    }
}

component AppDropdown inherits Rectangle {
    in property <[string]> options: [];
    in-out property <string> value: "";
    in property <bool> dark-theme: true;
    in property <bool> is-enabled: true;
    in property <length> control-width: 150px;
    in-out property <bool> opened: false;
    callback selected(string);
    callback popup-opened(bool);

    width: root.control-width;
    height: 38px;
    border-radius: 8px;
    background: !root.is-enabled
        ? (root.dark-theme ? #262626 : #e9e9e9)
        : (root.dark-theme ? #303030 : #e7e7e7);
    z: root.opened ? 30 : 0;

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;
        Text {
            text: root.value;
            color: root.is-enabled
                ? (root.dark-theme ? #eeeeee : #242424)
                : (root.dark-theme ? #777777 : #969696);
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.opened ? "⌃" : "⌄";
            color: root.dark-theme ? #bcbcbc : #5c5c5c;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: root.is-enabled;
        clicked => {
            root.opened = !root.opened;
            root.popup-opened(root.opened);
        }
    }

    if root.opened: Rectangle {
        y: root.height + 4px;
        width: root.width;
        height: 34px * root.options.length;
        z: 50;
        border-radius: 8px;
        background: root.dark-theme ? #303030 : #e7e7e7;
        VerticalLayout {
            padding: 4px;
            spacing: 2px;
            for option[index] in root.options: Rectangle {
                height: 30px;
                border-radius: 6px;
                background: option == root.value
                    ? (root.dark-theme ? #4a4a4a : #d0d0d0)
                    : (option_touch.has-hover
                        ? (root.dark-theme ? #3b3b3b : #dadada)
                        : #00000000);
                Text {
                    text: option;
                    color: root.dark-theme ? #eeeeee : #252525;
                    font-size: 12px;
                    vertical-alignment: center;
                    x: 8px;
                    width: parent.width - 16px;
                    overflow: elide;
                }
                option_touch := TouchArea {
                    clicked => {
                        root.value = option;
                        root.opened = false;
                        root.popup-opened(false);
                        root.selected(option);
                    }
                }
            }
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> dark-theme: true;
    in property <length> control-width: 96px;
    callback edited(string);

    preferred-width: root.control-width;
    height: 38px;
    border-radius: 8px;
    clip: true;
    background: input_field.has-focus
        ? (root.dark-theme ? #3a3a3a : #dcdcdc)
        : (root.dark-theme ? #2b2b2b : #e9e9e9);

    input_field := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: root.dark-theme ? #eeeeee : #222222;
        selection-background-color: root.dark-theme ? #686868 : #bcbcbc;
        selection-foreground-color: root.dark-theme ? #ffffff : #111111;
        font-size: 13px;
        vertical-alignment: center;
        edited => {
            root.text = input_field.text;
            root.edited(input_field.text);
        }
    }
    if root.text == "" && root.placeholder != "" && !input_field.has-focus: Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: root.dark-theme ? #777777 : #888888;
        font-size: 13px;
        vertical-alignment: center;
    }
}

component SwitchToggle inherits HorizontalLayout {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> available: true;
    in property <bool> dark-theme: true;
    callback toggled(bool);

    spacing: 9px;
    alignment: center;

    Text {
        text: root.label;
        color: root.available
            ? (root.dark-theme ? #dedede : #333333)
            : (root.dark-theme ? #777777 : #999999);
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Rectangle {
        width: 42px;
        height: 24px;
        border-radius: 12px;
        background: !root.available
            ? (root.dark-theme ? #303030 : #dedede)
            : (root.active
                ? (root.dark-theme ? #e4e4e4 : #333333)
                : (root.dark-theme ? #424242 : #cfcfcf));

        Rectangle {
            x: root.active ? 21px : 3px;
            y: 3px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: root.active
                ? (root.dark-theme ? #222222 : #ffffff)
                : (root.dark-theme ? #bdbdbd : #666666);
        }

        TouchArea {
            enabled: root.available;
            clicked => { root.toggled(!root.active); }
        }
    }
}

component ValueSlider inherits Rectangle {
    in-out property <float> value: 50;
    in property <bool> dark-theme: true;
    in property <bool> is-enabled: true;
    callback changed(float);

    horizontal-stretch: 1;
    min-width: 88px;
    height: 24px;

    Rectangle {
        x: 0px;
        y: 10px;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: root.dark-theme ? #484848 : #c8c8c8;
    }
    Rectangle {
        x: 0px;
        y: 10px;
        width: parent.width * max(0.0, min(100.0, root.value)) / 100;
        height: 4px;
        border-radius: 2px;
        background: root.dark-theme ? #d8d8d8 : #515151;
    }
    handle := Rectangle {
        width: 16px;
        height: 16px;
        y: 4px;
        x: max(0px, min(root.width - self.width,
            root.width * max(0.0, min(100.0, root.value)) / 100 - self.width / 2));
        border-radius: 8px;
        background: root.is-enabled
            ? (root.dark-theme ? #eeeeee : #292929)
            : (root.dark-theme ? #777777 : #999999);
    }
    touch := TouchArea {
        enabled: root.is-enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.value = max(0.0, min(100.0, self.mouse-x * 100 / root.width));
                root.changed(root.value);
            }
        }
        moved => {
            if self.pressed {
                root.value = max(0.0, min(100.0, self.mouse-x * 100 / root.width));
                root.changed(root.value);
            }
        }
        clicked => {
            root.value = max(0.0, min(100.0, self.mouse-x * 100 / root.width));
            root.changed(root.value);
        }
    }
}

component ThrottleControl inherits HorizontalLayout {
    in property <string> fan-label: "";
    in property <int> current-throttle: 50;
    in property <bool> dark-theme: true;
    in property <bool> is-enabled: true;
    in-out property <float> draft-throttle: root.current-throttle;
    in-out property <bool> dirty: false;
    callback save(string, int);

    spacing: 9px;
    alignment: center;

    changed current-throttle => {
        if !root.dirty { root.draft-throttle = root.current-throttle; }
    }

    Text {
        text: "PWM · \{round(root.draft-throttle)}%";
        color: root.dark-theme ? #c7c7c7 : #555555;
        font-size: 11px;
        width: 88px;
        vertical-alignment: center;
    }
    ValueSlider {
        value: root.draft-throttle;
        dark-theme: root.dark-theme;
        is-enabled: root.is-enabled;
        changed(value) => {
            root.draft-throttle = value;
            root.dirty = round(value) != root.current-throttle;
        }
    }
    ActionButton {
        label: "✓";
        control-width: 36px;
        dark-theme: root.dark-theme;
        primary: true;
        is-enabled: root.is-enabled && root.dirty;
        clicked => {
            root.save(root.fan-label, round(root.draft-throttle));
            root.dirty = false;
        }
    }
}

component RangeRail inherits Rectangle {
    in property <bool> dark-theme: true;
    horizontal-stretch: 1;
    height: 22px;
    background: #00000000;

    Rectangle {
        x: 0px;
        y: 9px;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: root.dark-theme ? #454545 : #cccccc;
    }
    Rectangle {
        x: 0px;
        y: 6px;
        width: 12px;
        height: 10px;
        border-radius: 5px;
        background: root.dark-theme ? #dadada : #424242;
    }
    Rectangle {
        x: parent.width - 12px;
        y: 6px;
        width: 12px;
        height: 10px;
        border-radius: 5px;
        background: root.dark-theme ? #dadada : #424242;
    }
}

export component MainWindow inherits Window {
    title: "FCP Control";
    preferred-width: 1080px;
    preferred-height: 820px;
    min-width: 760px;
    min-height: 600px;
    background: root.dark-theme ? #141414 : #f2f2f2;

    in-out property <bool> dark-theme: true;
    in-out property <string> status-message: "Ready.";
    in-out property <string> connection-summary: "Connecting to fcp and fcptemp…";
    in-out property <string> selected-fan: "";
    in-out property <string> expanded-fan: "";
    in-out property <string> dropdown-open-fan: "";
    in-out property <[string]> fan-labels: [];
    in-out property <[string]> fan-modes: [];
    in-out property <[string]> fan-throttles: [];
    in-out property <[int]> fan-throttle-values: [];
    in-out property <[string]> fan-rpms: [];
    in-out property <[string]> fan-rule-states: [];
    in-out property <[string]> sensor-ids: [];
    in-out property <[string]> sensor-row-ids: [];
    in-out property <[string]> sensor-values: [];
    in-out property <[string]> sensor-details: [];
    in-out property <[string]> sensor-states: [];
    in-out property <[string]> rule-fans: [];
    in-out property <[string]> rule-details: [];
    in-out property <[string]> rule-states: [];
    in-out property <bool> automation-enabled: false;
    in-out property <bool> fcptemp-connected: false;
    in-out property <string> automation-label: "Automation unavailable";
    in-out property <string> temperature-unit: "°C";

    in-out property <string> selected-sensor: "";
    in-out property <string> curve-type: "linear";
    in-out property <string> min-temp-text: "30";
    in-out property <string> max-temp-text: "70";
    in-out property <string> exponent-text: "2";
    in-out property <string> points-text: "40:50";
    in-out property <bool> selected-rule-exists: false;
    in-out property <bool> selected-rule-enabled: false;
    in-out property <string> selected-rule-summary: "No rule for this fan";

    private property <color> surface: root.dark-theme ? #1f1f1f : #ffffff;
    private property <color> row-surface: root.dark-theme ? #262626 : #eeeeee;
    private property <color> selected-surface: root.dark-theme ? #383838 : #dddddd;
    private property <color> main-text: root.dark-theme ? #f0f0f0 : #202020;
    private property <color> secondary-text: root.dark-theme ? #b8b8b8 : #5a5a5a;
    private property <color> muted-text: root.dark-theme ? #858585 : #777777;

    callback fan-selected(string);
    callback set-throttle(string, int);
    callback set-mode(string, string);
    callback kickstart(string);
    callback toggle-automation(bool);
    callback save-rule(string, string, string, string, string, int, int, string, string);
    callback toggle-rule(string, bool);
    callback delete-rule(string);

    VerticalLayout {
        spacing: 0px;

        // Application bar: title, connection state, global automation and theme.
        Rectangle {
            height: 72px;
            vertical-stretch: 0;
            background: root.surface;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 14px;
                alignment: center;

                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    background: root.dark-theme ? #e8e8e8 : #292929;
                    Text {
                        text: "F";
                        width: parent.width;
                        height: parent.height;
                        color: root.dark-theme ? #202020 : #f4f4f4;
                        font-size: 23px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    width: 142px;
                    spacing: 2px;
                    alignment: center;
                    Text { text: "FCP-GUI"; color: root.main-text; font-size: 19px; font-weight: 700; }
                    Text { text: "FAN CONTROL"; color: root.muted-text; font-size: 9px; font-weight: 600; }
                }
                Rectangle { horizontal-stretch: 1; background: #00000000; }
                Text {
                    text: root.connection-summary;
                    width: 220px;
                    color: root.secondary-text;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                SwitchToggle {
                    label: "TEMP AUTO";
                    active: root.automation-enabled;
                    available: root.fcptemp-connected;
                    dark-theme: root.dark-theme;
                    toggled(value) => { root.toggle-automation(value); }
                }
                ActionButton {
                    label: root.dark-theme ? "Light" : "Dark";
                    control-width: 76px;
                    dark-theme: root.dark-theme;
                    clicked => { root.dark-theme = !root.dark-theme; }
                }
            }
        }

        // Compact live sensor table, pinned above the independently scrollable fan list.
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 0;
            background: root.surface;
            border-radius: 12px;
            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 13px;
                padding-bottom: 13px;
                spacing: 6px;

                HorizontalLayout {
                    alignment: center;
                    Text { text: "TEMPERATURE SENSORS"; color: root.main-text; font-size: 12px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Text { text: "LIVE · " + root.temperature-unit; color: root.muted-text; font-size: 10px; font-weight: 600; }
                }
                HorizontalLayout {
                    height: 19px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text { text: ""; width: 9px; }
                    Text { text: "Sensor"; color: root.muted-text; font-size: 10px; width: 190px; vertical-alignment: center; }
                    Text { text: "Driver details"; color: root.muted-text; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: "Temperature"; color: root.muted-text; font-size: 10px; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                }
                for sensor-id[index] in root.sensor-row-ids: Rectangle {
                    height: 28px;
                    border-radius: 7px;
                    background: Math.mod(index, 2) == 0 ? root.row-surface : root.surface;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: root.sensor-states[index] == "ok" ? root.main-text : root.muted-text;
                        }
                        Text {
                            text: sensor-id;
                            color: root.main-text;
                            font-size: 11px;
                            width: 190px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.sensor-details[index];
                            color: root.muted-text;
                            font-size: 10px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.sensor-values[index];
                            color: root.main-text;
                            font-size: 11px;
                            font-weight: 600;
                            width: 90px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.sensor-row-ids.length == 0: Text {
                    text: "No temperature sensors detected.";
                    color: root.muted-text;
                    font-size: 12px;
                }
            }
        }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 8px;
            alignment: center;
            Text { text: "FANS"; color: root.main-text; font-size: 12px; font-weight: 700; }
            Rectangle { horizontal-stretch: 1; background: #00000000; }
            Text { text: "CUSTOM PWM"; color: root.muted-text; font-size: 10px; font-weight: 600; }
        }

        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 16px;
                spacing: 9px;

                for fan-label[index] in root.fan-labels: Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    border-radius: 12px;
                    background: root.expanded-fan == fan-label ? root.selected-surface : root.surface;
                    z: (root.expanded-fan == fan-label || root.dropdown-open-fan == fan-label) ? 100 : 0;
                    VerticalLayout {
                        spacing: 0px;

                        HorizontalLayout {
                            padding: 13px;
                            spacing: 12px;
                            alignment: center;
                            VerticalLayout {
                                width: 120px;
                                spacing: 3px;
                                Text { text: fan-label; color: root.main-text; font-size: 13px; font-weight: 700; }
                                Text { text: root.fan-rpms[index]; color: root.secondary-text; font-size: 11px; }
                                Text { text: root.fcptemp-connected ? root.fan-rule-states[index] : "Rule status unavailable"; color: root.muted-text; font-size: 9px; }
                            }
                            AppDropdown {
                                control-width: 126px;
                                dark-theme: root.dark-theme;
                                options: ["Low", "High", "Percent", "Unavailable"];
                                value: root.fan-modes[index] == "Custom" ? "Percent" : root.fan-modes[index];
                                is-enabled: root.fan-modes[index] != "Unavailable";
                                popup-opened(value) => {
                                    root.dropdown-open-fan = value ? fan-label : "";
                                }
                                selected(value) => {
                                    if value == "Low" { root.set-mode(fan-label, "low"); }
                                    else if value == "High" { root.set-mode(fan-label, "high"); }
                                    else if value == "Percent" { root.set-mode(fan-label, "percent"); }
                                }
                            }
                            ThrottleControl {
                                horizontal-stretch: 1;
                                fan-label: fan-label;
                                current-throttle: root.fan-throttle-values[index];
                                dark-theme: root.dark-theme;
                                is-enabled: root.fan-modes[index] != "Unavailable";
                                save(fan, throttle) => { root.set-throttle(fan, throttle); }
                            }
                            ActionButton {
                                label: root.expanded-fan == fan-label ? "⌃" : "⌄";
                                control-width: 38px;
                                dark-theme: root.dark-theme;
                                clicked => {
                                    if root.expanded-fan == fan-label {
                                        root.expanded-fan = "";
                                    } else {
                                        root.expanded-fan = fan-label;
                                        root.selected-fan = fan-label;
                                        root.fan-selected(fan-label);
                                    }
                                }
                            }
                        }

                        if root.expanded-fan == fan-label: Rectangle {
                            height: 1px;
                            background: root.dark-theme ? #414141 : #d8d8d8;
                        }

                        if root.expanded-fan == fan-label: VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 14px;
                            padding-bottom: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: center;
                                Text { text: "TEMPERATURE RULE"; color: root.main-text; font-size: 12px; font-weight: 700; }
                                Rectangle { horizontal-stretch: 1; background: #00000000; }
                                SwitchToggle {
                                    label: root.selected-rule-exists ? "RULE ENABLED" : "NO RULE";
                                    active: root.selected-rule-enabled;
                                    available: root.fcptemp-connected && root.selected-rule-exists;
                                    dark-theme: root.dark-theme;
                                    toggled(value) => { root.toggle-rule(fan-label, value); }
                                }
                            }
                            Text {
                                text: root.selected-rule-summary;
                                color: root.secondary-text;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 5px;
                                    Text { text: "TEMPERATURE SOURCE"; color: root.muted-text; font-size: 10px; font-weight: 600; }
                                    AppDropdown {
                                        horizontal-stretch: 1;
                                        control-width: 190px;
                                        dark-theme: root.dark-theme;
                                        options: root.sensor-ids;
                                        value: root.selected-sensor;
                                        is-enabled: root.fcptemp-connected;
                                        popup-opened(value) => { root.dropdown-open-fan = value ? fan-label : ""; }
                                        selected(value) => { root.selected-sensor = value; }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 5px;
                                    Text { text: "CURVE SHAPE"; color: root.muted-text; font-size: 10px; font-weight: 600; }
                                    AppDropdown {
                                        horizontal-stretch: 1;
                                        control-width: 190px;
                                        dark-theme: root.dark-theme;
                                        options: ["Linear", "Power", "Points"];
                                        value: root.curve-type == "linear" ? "Linear" : (root.curve-type == "power" ? "Power" : "Points");
                                        is-enabled: root.fcptemp-connected;
                                        popup-opened(value) => { root.dropdown-open-fan = value ? fan-label : ""; }
                                        selected(value) => {
                                            root.curve-type = value == "Linear" ? "linear" : (value == "Power" ? "power" : "points");
                                        }
                                    }
                                }
                                if root.curve-type == "power": VerticalLayout {
                                    width: 180px;
                                    spacing: 5px;
                                    Text { text: "POWER EXPONENT (n)"; color: root.muted-text; font-size: 10px; font-weight: 600; }
                                    TextField {
                                        horizontal-stretch: 1;
                                        control-width: 180px;
                                        text: root.exponent-text;
                                        placeholder: "2.0";
                                        dark-theme: root.dark-theme;
                                        edited(value) => { root.exponent-text = value; }
                                    }
                                }
                            }

                            if root.curve-type == "power": Text {
                                text: "Higher n keeps the throttle lower for longer, then increases it more sharply near the maximum temperature.";
                                color: root.muted-text;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            if root.curve-type == "points": VerticalLayout {
                                spacing: 5px;
                                Text { text: "INTERMEDIATE POINTS · °C:THROTTLE (UP TO 8)"; color: root.muted-text; font-size: 10px; font-weight: 600; }
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.points-text;
                                    placeholder: "40:50, 50:75";
                                    dark-theme: root.dark-theme;
                                    edited(value) => { root.points-text = value; }
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "TEMPERATURE RANGE · °C"; color: root.muted-text; font-size: 10px; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;
                                    VerticalLayout {
                                        width: 104px;
                                        spacing: 4px;
                                        Text { text: "MINIMUM"; color: root.muted-text; font-size: 9px; }
                                        TextField {
                                            control-width: 104px;
                                            text: root.min-temp-text;
                                            placeholder: "30";
                                            dark-theme: root.dark-theme;
                                            edited(value) => { root.min-temp-text = value; }
                                        }
                                    }
                                    RangeRail { dark-theme: root.dark-theme; }
                                    VerticalLayout {
                                        width: 104px;
                                        spacing: 4px;
                                        Text { text: "MAXIMUM"; color: root.muted-text; font-size: 9px; }
                                        TextField {
                                            control-width: 104px;
                                            text: root.max-temp-text;
                                            placeholder: "70";
                                            dark-theme: root.dark-theme;
                                            edited(value) => { root.max-temp-text = value; }
                                        }
                                    }
                                }
                                Text { text: "Throttle rises from 0% to 100% across this temperature range."; color: root.secondary-text; font-size: 11px; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                ActionButton {
                                    label: "Save rule";
                                    control-width: 108px;
                                    primary: true;
                                    dark-theme: root.dark-theme;
                                    is-enabled: root.fcptemp-connected && root.selected-sensor != "";
                                    clicked => {
                                        root.save-rule(root.selected-fan, root.selected-sensor, root.curve-type,
                                            root.min-temp-text, root.max-temp-text, 0, 100,
                                            root.exponent-text, root.points-text);
                                    }
                                }
                                ActionButton {
                                    label: "Delete rule";
                                    control-width: 100px;
                                    dark-theme: root.dark-theme;
                                    is-enabled: root.fcptemp-connected && root.selected-rule-exists;
                                    clicked => { root.delete-rule(fan-label); }
                                }
                                ActionButton {
                                    label: "Kickstart";
                                    control-width: 92px;
                                    dark-theme: root.dark-theme;
                                    is-enabled: root.fan-modes[index] != "Unavailable";
                                    clicked => { root.kickstart(fan-label); }
                                }
                                Rectangle { horizontal-stretch: 1; background: #00000000; }
                            }
                        }
                    }
                }

                if root.fan-labels.length == 0: Rectangle {
                    horizontal-stretch: 1;
                    height: 76px;
                    border-radius: 12px;
                    background: root.surface;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        Text { text: "No controllable fans"; color: root.main-text; font-size: 13px; font-weight: 700; }
                        Text { text: "Check fcp.service and its control socket."; color: root.secondary-text; font-size: 11px; }
                    }
                }
            }
        }

        Rectangle {
            height: 30px;
            vertical-stretch: 0;
            background: root.surface;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Text {
                    text: root.status-message;
                    color: root.secondary-text;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component FcpTray inherits SystemTrayIcon {
    icon: @image-url("assets/tray.png");
    tooltip: "FCP Control";
    title: "FCP Control";

    Menu {
        MenuItem { title: "Open window"; activated => { root.open-requested(); } }
        MenuSeparator { }
        MenuItem { title: "Quit"; activated => { root.quit-requested(); } }
    }

    callback open-requested();
    callback quit-requested();
    clicked => { root.open-requested(); }
}
