[Unit]
Description=FCP custom PWM fan control
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fcp
# Type=simple only waits for the process to start, not for its Unix socket.
# ExecStartPost keeps dependent services ordered until the API socket is bound.
ExecStartPost=/usr/bin/bash -c 'for ((i=0; i<100; i++)); do if test -S /run/fcp/control.sock; then exit 0; fi; sleep 0.1; done; echo "Timed out waiting for FCP socket /run/fcp/control.sock" >&2; exit 1'
TimeoutStartSec=20s
Restart=on-failure
RestartSec=1
Environment=CONFIG_PATH=/etc/fcp/config.json
Environment=STATE_PATH=/var/lib/fcp/state.json
Environment=SOCKET_PATH=/run/fcp/control.sock
StateDirectory=fcp
RuntimeDirectory=fcp
RuntimeDirectoryMode=0755
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
