[Unit]
Description=FCP custom PWM fan control
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fcp
Restart=on-failure
RestartSec=1
Environment=CONFIG_PATH=/etc/fcp/config.json
Environment=STATE_PATH=/var/lib/fcp/state.json
Environment=SOCKET_PATH=/run/fcp/control.sock
StateDirectory=fcp
RuntimeDirectory=fcp
RuntimeDirectoryMode=0755
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
